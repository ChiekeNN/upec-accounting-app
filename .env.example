# ─────────────────────────────────────────────────────────────
# UPEC Accounting — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Neon Postgres ───────────────────────────────────────────
# Neon Console → your project → "Connect" button, or `vercel env pull .env`
# (Vercel names the direct one DATABASE_URL_UNPOOLED — either name works).
# Tip: change "sslmode=require" to "sslmode=verify-full" to silence a harmless
# node-postgres SSL warning (the connection is fully verified either way).
#
# DATABASE_URL: the POOLED connection string (host contains "-pooler").
#   Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# DATABASE_URL_DIRECT: the DIRECT connection string (toggle "Connection pooling" OFF).
#   Used only for migrations (`npm run db:migrate`). Optional — falls back to DATABASE_URL.
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# ── Bootstrap accounts ──────────────────────────────────────
# Created on the first request if the email does not already exist.
# Existing accounts are NEVER modified, so a name corrected in Settings or a
# password rotated by a user survives every later deploy.
#
# Leave BOOTSTRAP_ADMIN_PASSWORD empty/commented to run DEMO MODE:
#   sample data, and one-click sign-in for all three roles below using the
#   shared demo password "UpecDemo@2026!".
# Set it for a REAL deployment: empty books, no demo sign-in, and the Director
#   and Finance Officer are created only if their own passwords are set here.
# Generate a strong one with:  npm run gen:password

# Administrator — full access, the only role that can manage other Administrators.
BOOTSTRAP_ADMIN_EMAIL="chiekenn@gmail.com"
BOOTSTRAP_ADMIN_NAME="Chieke Nnadi"
# BOOTSTRAP_ADMIN_PASSWORD=""

# Director — executive oversight: the Director Admin area, approvals and team management.
DIRECTOR_EMAIL="director@upec.edu.ng"
DIRECTOR_NAME="UPEC Director"
# DIRECTOR_PASSWORD=""

# Finance Officer — records, posts and corrects transactions, budgets and accounts.
FINANCE_OFFICER_EMAIL="fo@upec.edu.ng"
FINANCE_OFFICER_NAME="UPEC Finance Officer"
# FINANCE_OFFICER_PASSWORD=""

# Note: no auth secret / session key is needed. Sessions are random
# 256-bit tokens stored (hashed) in the database, not signed cookies.
